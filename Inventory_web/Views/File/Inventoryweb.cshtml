@model IEnumerable<Inventoryweb.Models.Products>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers


@{
    var categoryList = Model.Select(p => p.Category).Distinct().ToList();
}
<HTML>
    <HEAD>
        <TITLE>
          <b> INVENTORY PORTAL</b>
        </TITLE>
         <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
 <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
 <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
 <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


 <link rel="stylesheet" href="~/css/Inventoryweb.css">
 
    </HEAD>
    <body>
   
        <H1 STYLE="color: rgb(238, 93, 8);text-align: center;"><b>   INVENTORY PORTAL</b>

        </H1>


<nav class="navbar navbar-expand-sm bg-danger navbar-dark">
  <div class="container-fluid">
    <ul class="navbar-nav me-auto">
            <li>
    <a class="nav-link  active fw-bold fs-4" asp-controller="File" asp-action="Productstats">Dashboard</a>
</li>
      <li class="nav-item me-4">
     
      <li class="nav-item dropdown me-4">
        <a class="nav-link  active dropdown-toggle fw-bold fs-4" href="#" id="sonyDropdown" role="button" data-bs-toggle="dropdown">
          Products
        </a>
        <ul class="dropdown-menu">
       <li>
    <a class="dropdown-item" asp-controller="File" asp-action="Productpage">Edit and Search</a>
</li>
         
        </ul>
      </li>
   
    </ul>
  </div>
</nav>

                             <!--SEARCH BAR--> 




<button class="btn btn-primary mb-3" onclick="saveTableAsPDF()">Save as PDF</button>


  @if (Model != null && Model.Any())
        { 
           
                    <table id="myTable" class="table table-hover table-striped align-middle shadow-sm rounded">
<thead class="text-center bg-success text-white">

                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>CreatedDate</th>
                        <th>IsDiscontinued</th>
                       
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        
             

                        <tr>
                            <td>@product.Id</td>
                            <td>@product.Name</td>
                            <td>@product.Description</td>
                            <td>@product.Category</td>
                            <td>@product.Price</td>
                            <td>@product.Stock
                            
                                  <span class="@(product.Stock < 5 ? "fw-bold text-danger" : "")">
            
        </span>
        @if (product.Stock < 5)
        {
            <span class="badge bg-danger ms-2">Low Stock</span>
        }</td>
                            <td>@product.CreatedDate</td>
                            <td>@product.IsDiscontinued
                              @if (product.IsDiscontinued)
                                {
                                    <span class="badge bg-warning text-dark">REMOVED</span>
                                }</td>
                          
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No data available.</p>
        }
</body>

        <script>
  async function saveTableAsPDF() {
    const { jsPDF } = window.jspdf;
    const table = document.getElementById("myTable");

    html2canvas(table).then(canvas => {
      const imgData = canvas.toDataURL('image/png');
      const pdf = new jsPDF();

      const imgProps = pdf.getImageProperties(imgData);
      const pdfWidth = pdf.internal.pageSize.getWidth();
      const pdfHeight = (imgProps.height * pdfWidth) / imgProps.width;

      pdf.addImage(imgData, 'PNG', 0, 0, pdfWidth, pdfHeight);
      pdf.save("table.pdf");
    });
  }
</script>

</html>

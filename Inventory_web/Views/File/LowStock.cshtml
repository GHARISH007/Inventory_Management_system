@model IEnumerable<Inventoryweb.Models.Products>
@using System.Linq
<!DOCTYPE html>
<html>
<head>
    <title>Low Stock Products</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <div class="container mt-5">
        <h2 class="mb-4 text-center text-danger">🚨 Low Stock Products (Less Than 5)</h2>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-bordered table-striped align-middle shadow rounded-3 overflow-hidden">
                    <thead class="table-success text-center">
                        <tr>
                            <th>Id</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Created Date</th>
                            <th>Status</th>
                            <th>update</th>
                        </tr>
                    </thead>
                    <tbody class="text-center">
                        @foreach (var product in Model)
                        {
                            <tr class="@(product.Stock < 5 ? "table-danger fw-bold" : "")">
                                <td>@product.Id</td>
                                <td>@product.Name</td>
                                <td>@product.Description</td>
                                <td>@product.Category</td>
                                <td> @product.Price</td>
                                <td>
                                    @product.Stock
                                    @if (product.Stock < 5)
                                    {
                                        <span class="badge bg-danger ms-2">Low</span>
                                    }
                                </td>
                                <td>@product.CreatedDate</td>
                                <td>
                                    @if (product.IsDiscontinued)
                                    {
                                        <span class="badge bg-warning text-dark">Discontinued</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>
                                <td>
                               
                           </td>
                           </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">No low stock products found.</div>
        }
    </div>
</body>
</html>

